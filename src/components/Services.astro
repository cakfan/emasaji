---
import site from '../data/site.json';

const icons = {
  wheel: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M12 3v6.5M12 14.5V21M4.5 7.5l5 4M14.5 12.5l5-4M4.5 16.5l5-4M14.5 11.5l5 4"/>`,
  document: `<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M9.5 12h5M9.5 15.5h5"/>`,
};
---

<section id="layanan" class="section services">
  <div class="container">
    <span class="eyebrow">Layanan</span>
    <h2 class="services__title">Satu tempat, semua kebutuhan berkendara Anda</h2>

    <div class="services__grid">
      {site.services.map((s, i) => (
        <article class="service-card" data-reveal style={`--i: ${i}`}>
          <svg class="service-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" set:html={icons[s.icon]} />
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services__title {
    margin-top: 18px;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    max-width: 620px;
  }
  .services__grid {
    margin-top: 52px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .service-card {
    background: var(--bg);
    padding: 32px 26px;
    transition: background 0.25s ease;
  }
  .service-card:hover { background: var(--bg-elevated); }
  .service-card__icon {
    width: 30px;
    height: 30px;
    color: var(--white);
    margin-bottom: 20px;
  }
  .service-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .service-card p {
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 560px) {
    .services__grid { grid-template-columns: 1fr; }
  }
</style>
